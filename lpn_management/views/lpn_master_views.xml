<odoo>

    <!-- Tree View -->
    <record id="view_lpn_master_tree" model="ir.ui.view">
        <field name="name">lpn.master.tree</field>
        <field name="model">lpn.master</field>
        <field name="arch" type="xml">
            <tree>
               <field name="name"/>
               <field name="rfid_code" optional="show"/>
               <field name="generation_date" optional="show"/>
               <field name="subinventory_code" optional="show"/>
               <field name="max_qty" optional="show"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_lpn_master_form" model="ir.ui.view">
        <field name="name">lpn.master.form</field>
        <field name="model">lpn.master</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
						<label for="name" class="oe_edit_only"/>
						<h1>
							<field name="name" placeholder="e.g. X10 engine"/>
						</h1>
					</div>
                    <group>
                       <group>
                          <field name="generation_date"/>
                          <field name="rfid_code"/>
                       </group>
                       <group>
                          <field name="subinventory_code"/>
                          <field name="max_qty"/>
                          <field name="physical_audit"/>
                       </group>
                    </group>
                    <notebook>
                        <page string="Child LPNs">
                            <field name="child_lpn_ids">
                                <tree editable="bottom">
                                   <field name="name"/>
                                   <field name="subinventory_code"/>
                                   <field name="turbo_qty"/>
                                   <field name="tsn"/>
                                   <field name="turbo_item"/>
                                   <field name="turbo_type"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user" options="{'no_open': True}"/>
                    <field name="message_ids" options="{'no_open': True}"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_lpn_master_search" model="ir.ui.view">
        <field name="name">lpn.master.search</field>
        <field name="model">lpn.master</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="rfid_code"/>
                <field name="subinventory_code"/>
                <filter string="Today" name="today" domain="[('generation_date','=',context_today())]"/>
            </search>
        </field>
    </record>
   
    <!-- action LPN Master -->
    <record id="action_lpn_master" model="ir.actions.act_window">
        <field name="name">List of Master LPN</field>
        <field name="res_model">lpn.master</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
    </record>
   
    <menuitem id="menu_lpn_root" name="Cummins - Asset Management"/>
   
    <menuitem id="menu_lpn_master" name="List of Master LPN" action="action_lpn_master"
              parent="lpn_management.menu_lpn_root" sequence="2"/>
    
    <!-- Tree View -->
    <record id="view_lpn_child_tree" model="ir.ui.view">
        <field name="name">lpn.child.tree</field>
        <field name="model">lpn.child</field>
        <field name="arch" type="xml">
            <tree>
               <field name="parent_id"/>
               <field name="name"/>
               <field name="subinventory_code"/>
               <field name="turbo_qty"/>
               <field name="tsn"/>
               <field name="turbo_item"/>
               <field name="turbo_type"/>
            </tree>
        </field>
    </record>
   
    <!-- Action LPN Master -->
    <record id="action_child_lpn_master" model="ir.actions.act_window">
        <field name="name">Child LPN</field>
        <field name="res_model">lpn.child</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
    </record>
   
<!--    <menuitem id="menu_child_lpn_master" name="Child LPN" action="action_child_lpn_master"-->
<!--              parent="lpn_management.menu_lpn_root" sequence="3"/>-->
  
</odoo>