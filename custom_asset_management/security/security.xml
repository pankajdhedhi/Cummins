<odoo>
	<!-- Technician group -->
	<record id="group_technician" model="res.groups">
		<field name="name">Technicians</field>
	</record>

	<!-- admin can see all orders -->
	<record id="administrator_see_all_orders" model="ir.rule">
		<field name="name">Administrator : All Orders</field>
		<field name="model_id" ref="model_order_order"/>
		<field name="domain_force">[(1,'=',1)]</field>
		<field name="groups" eval="[(4, ref('base.group_erp_manager'))]"/>
	</record>
	
	<record id ="module_category_assets_role" model ="ir.module.category">
        <field name="name">Assets Role</field>
    </record>

    <record id="group_central_finance" model="res.groups">
        <field name="name">Central Finance</field>
		<field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
        <field name="category_id" ref="custom_asset_management.module_category_assets_role"/>
    </record>

	<record id="group_central_finance_manager" model="res.groups">
        <field name="name">Central Finance Manager</field>
		<field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
        <field name="category_id" ref="custom_asset_management.module_category_assets_role"/>
    </record>

	<record id="group_central_finance_it_manager" model="res.groups">
        <field name="name">IT Manager</field>
		<field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
        <field name="category_id" ref="custom_asset_management.module_category_assets_role"/>
    </record>

    <record id="group_local_finance" model="res.groups">
        <field name="name">Local Finance</field>
        <field name="category_id" ref="custom_asset_management.module_category_assets_role"/>
		<field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
<!--        <field name="implied_ids" eval="[(4, ref('custom_asset_management.group_technician'))]"/>-->
    </record>

	<!-- Technician wise orders -->
	<record id="technician_wise_orders" model="ir.rule">
		<field name="name">Orders : Technicians</field>
		<field name="model_id" ref="model_order_order"/>
		<field name="domain_force">[('technician_id','=',user.id)]</field>
		<field name="groups" eval="[(4, ref('custom_asset_management.group_technician')),(4, ref('custom_asset_management.group_local_finance'))]"/>
	</record>
</odoo>