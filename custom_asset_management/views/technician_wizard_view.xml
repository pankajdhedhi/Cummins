<odoo>
	<!-- Technicia form view -->
	<record id="view_order_technician_wizard" model="ir.ui.view">
		<field name="name">order.technician.form</field>
		<field name="model">order.technician</field>
		<field name="arch" type="xml">
			<form string="Technician" duplicate="0">
				<sheet>
					<group>
						<group>
							<field name="technician_id" domain="[('plant_id', 'in', plant_id)]"/>
							<field name="approval_id"/>
						</group>
						<group>
							<field name="plant_id" force_save="1" readonly="1"/>
						</group>
					</group>
				</sheet>
				<footer>
					<button name="assign_technician" type="object" string="Assign" class="oe_highlight"/>
						or
					<button special="cancel" string="Cancel"/>
				</footer>
			</form>
		</field>
	</record>

	<record model="ir.actions.act_window" id="action_technician_wizard">
		<field name="name">Assign</field>
		<field name="res_model">order.technician</field>
		<field name="view_mode">form</field>
		<field name="target">new</field>
	</record>

	<!-- Reject reason form view -->
	<record id="view_order_reject_reason_wizard" model="ir.ui.view">
		<field name="name">order.reject.form</field>
		<field name="model">order.reject</field>
		<field name="arch" type="xml">
			<form string="Technician">
				<sheet>
					<group>
						<group>
							<field name="reason"/>
							<field name="order_id" invisible="1"/>
                    		<field name="state" invisible="1"/>
						</group>
					</group>
				</sheet>
				<footer>
					<button name="action_reject_reson" type="object" string="Confirm Reason" class="oe_highlight"/>
						or
					<button special="cancel" string="Cancel"/>
				</footer>
			</form>
		</field>
	</record>

	<record model="ir.actions.act_window" id="action_reject_reason_wizard">
		<field name="name">Reject Reason</field>
		<field name="res_model">order.reject</field>
		<field name="view_mode">form</field>
		<field name="target">new</field>
	</record>
</odoo>